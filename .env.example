# Copy to .env (gitignored) and fill in. Every value is optional unless marked.

# --- Storage (required for the API and ingestion) ------------------------------------
# Pooled Neon URL (the API; PgBouncer transaction mode). Unset = in-memory store, which is
# empty until something ingests into it: fine for tests, useless for a deploy.
DATABASE_URL=
# Direct (unpooled) Neon URL for migrations and ingestion; falls back to DATABASE_URL.
DATABASE_DIRECT_URL=

# --- Embeddings (one model per corpus; see docs/decisions/0001-embedding-provider.md) --
# auto = Voyage when VOYAGE_API_KEY is set, otherwise Gemini.
EMBEDDING_PROVIDER=auto
GEMINI_API_KEY=
VOYAGE_API_KEY=
# Dimension of chunks.embedding, fixed by `uv run migrate`: 768 (gemini-embedding-001,
# Matryoshka-truncated) or 1024 (voyage-4-lite). Changing it later = re-embed (docs/setup.md).
EMBEDDING_DIMENSIONS=768
# Free-tier pacing for ingestion: texts per call, estimated tokens per call, tokens/minute.
EMBED_BATCH_SIZE=100
EMBED_BATCH_TOKENS=20000
EMBED_TPM=25000

# --- Generation (Groq primary, Gemini fallback; at least one) -------------------------
GROQ_API_KEY=
# Experiments only (llm-kit provider); not routed by default.
OPENROUTER_API_KEY=

# --- Retrieval ---------------------------------------------------------------------------
# Voyage rerank-2.5-lite runs only when VOYAGE_API_KEY is set and RERANK is true.
RERANK=true
CONTEXT_TOKEN_BUDGET=6000

# --- Ingestion ---------------------------------------------------------------------------
# Optional: 5,000 GitHub API requests/hour instead of 60 (the tree fetch uses 2-4).
GITHUB_TOKEN=

# --- API ---------------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3600,http://localhost:3000
PORT=7861
QUESTIONS_PER_HOUR_PER_IP=30
# Salt for hashing client IPs (rate limiting). Change it in production.
IP_HASH_SALT=
# Trust X-Forwarded-For (Vercel is trusted automatically via VERCEL=1).
TRUST_PROXY_HEADERS=false
CORPUS_MAX_AGE_DAYS=45

# --- Observability (optional) -------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
